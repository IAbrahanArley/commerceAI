            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"{{message}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "chat"
              ]
            },
            "description": "Envia uma mensagem para o assistente comercial. A resposta depende do LLM configurado no ambiente local."
          },
          "response": [
